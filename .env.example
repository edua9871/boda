# ─────────────────────────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — Invitación de Boda
#
# Copia este archivo como .env.local para desarrollo local (no se sube a Git).
# En producción, carga estas variables en:
#   Netlify → Project configuration → Environment variables
#
# IMPORTANTE: todas deben empezar con VITE_ para que Vite las exponga al navegador.
# ─────────────────────────────────────────────────────────────────────────────


# ── Pareja ────────────────────────────────────────────────────────────────────
# Las iniciales (ej. "M & L") se generan automáticamente desde estas dos variables.
VITE_NAME1=María Gómez
VITE_NAME2=Fabian Silva


# ── Fecha ─────────────────────────────────────────────────────────────────────
# Formato ISO completo — usado por el contador regresivo
VITE_WEDDING_DATE=2026-10-12T17:00:00
# Texto decorativo visible en el hero
VITE_WEDDING_DATE_DISPLAY=12 · 10 · 2026


# ── Hero (foto de portada) ────────────────────────────────────────────────────
# URL directa a la imagen de portada (Google Drive, Cloudinary, etc.)
VITE_HERO_IMAGE=https://tu-imagen.com/portada.jpg


# ── Historia ──────────────────────────────────────────────────────────────────
VITE_STORY1_DATE=Otoño 2018
VITE_STORY1_TITLE=El Primer Encuentro
VITE_STORY1_TEXT=Un café en el centro, una charla que duró horas...
VITE_STORY1_IMAGE=https://tu-imagen.com/historia1.jpg

VITE_STORY2_DATE=Verano 2023
VITE_STORY2_TITLE=El "Sí"
VITE_STORY2_TEXT=Bajo las estrellas y frente al mar...
VITE_STORY2_IMAGE=https://tu-imagen.com/historia2.jpg


# ── Ceremonia ─────────────────────────────────────────────────────────────────
VITE_CEREMONY_PLACE=Parroquia de San Ignacio
VITE_CEREMONY_TIME=17:00 Hrs.
# Link de Google Maps al lugar
VITE_CEREMONY_MAPS=https://maps.google.com/?q=Parroquia+de+San+Ignacio


# ── Recepción ─────────────────────────────────────────────────────────────────
VITE_RECEPTION_PLACE=Hacienda Las Palmeras
VITE_RECEPTION_TIME=19:30 Hrs.
VITE_RECEPTION_MAPS=https://maps.google.com/?q=Hacienda+Las+Palmeras


# ── Código de Vestimenta ──────────────────────────────────────────────────────
VITE_DRESSCODE_MEN=Traje Formal / Smoking
VITE_DRESSCODE_WOMEN=Vestido Largo de Gala
VITE_DRESSCODE_COLORS=Colores sugeridos: Tonos tierra, champagne y oscuros.


# ── Confirmación de Asistencia ────────────────────────────────────────────────
# Fecha límite para confirmar (texto libre, ej: "30 de Agosto")
VITE_RSVP_DEADLINE=15 de Septiembre
# Máximo de acompañantes que puede traer cada invitado
VITE_RSVP_MAX_GUESTS=5


# ── Visibilidad de secciones ─────────────────────────────────────────────────
# Por defecto todas están activas. Pon "false" para ocultar una sección.
# Hero siempre se muestra (es la portada).
VITE_SHOW_COUNTDOWN=true
VITE_SHOW_STORY=true
VITE_SHOW_EVENTS=true
VITE_SHOW_DRESSCODE=true
VITE_SHOW_RSVP=true
VITE_SHOW_PHOTOS=true


# ── Fotos / Google Drive ──────────────────────────────────────────────────────
# Link de la carpeta de Google Drive compartida (con permiso de Editor)
VITE_DRIVE_URL=https://drive.google.com/drive/folders/TU_ID_AQUI
